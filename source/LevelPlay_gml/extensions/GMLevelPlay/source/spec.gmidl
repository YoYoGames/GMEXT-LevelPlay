[gml_api]
module GMLevelPlay;


// =============================================================================
// Classes — callback payload object shapes
// =============================================================================

[global]
class `[[LevelPlayResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `string?`]
    property error_message : gmval { get; set; }
    [field, type_hint = `int32?`]
    property sdk_error_code : gmval { get; set; }
}

[global]
class `[[LevelPlayAdInfo]]` prototype Object
{
    [field] property width : int32 { get; set; }
    [field] property height : int32 { get; set; }
    [field, type_hint = `string?`]
    property format : gmval { get; set; }
    [field, type_hint = `string?`]
    property network : gmval { get; set; }
    [field, type_hint = `string?`]
    property unit_id : gmval { get; set; }
    [field, type_hint = `string?`]
    property unit_name : gmval { get; set; }
    [field, type_hint = `string?`]
    property placement_name : gmval { get; set; }
    [field, type_hint = `string?`]
    property country : gmval { get; set; }
    [field, type_hint = `string?`]
    property precision : gmval { get; set; }
    [field, type_hint = `real?`]
    property revenue : gmval { get; set; }
}

[global]
class `[[LevelPlayReward]]` prototype Object
{
    [field] property name : string { get; set; }
    [field] property amount : int32 { get; set; }
}

// -----------------------------------------------------------------------------
// Init / settings
// -----------------------------------------------------------------------------

/// Callback receives [[LevelPlayResult]].
[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_init(callback: func): gmval;

[global, bind = typed_gml]
function levelplay_is_initialized(): bool;

[global, bind = typed_gml]
function levelplay_set_consent(enable: bool): unit;

[global, bind = typed_gml]
function levelplay_set_metadata(key: string, value: string): unit;

[global, bind = typed_gml]
function levelplay_set_dynamic_user_id(user_id: string): unit;

[global, bind = typed_gml]
function levelplay_launch_test_suite(): unit;

// -----------------------------------------------------------------------------
// Interstitial
// -----------------------------------------------------------------------------

/// Constructs the interstitial ad instance and attaches callback as its listener for the handle's
/// whole lifetime (Loaded/LoadFailed, then every subsequent Displayed/DisplayFailed/Closed/Clicked/
/// InfoChanged event). Callback receives (result: [[LevelPlayResult]], type: [[LevelPlayCallbackEvent]],
/// ad_info: [[LevelPlayAdInfo]]?). Synchronous and effectively infallible - the returned handle is
/// reusable across many load/show cycles; call levelplay_interstitial_destroy when truly done with it.
[global, bind = typed_gml, type_hint = `uint64`]
function levelplay_interstitial_create(ad_unit_id: string, callback: func): gmval;

/// Requests a (re)load using the handle's existing callback (see levelplay_interstitial_create /
/// levelplay_interstitial_set_callback).
[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_interstitial_load([type_hint=`uint64`] handle: gmval): gmval;

/// Replaces the handle's active callback, in place of the one given to levelplay_interstitial_create.
[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_interstitial_set_callback([type_hint=`uint64`] handle: gmval, callback: func): gmval;

[global, bind = typed_gml]
function levelplay_interstitial_is_ready([type_hint=`uint64`] handle: gmval): bool;

[global, bind = typed_gml]
function levelplay_interstitial_is_placement_capped(placement_id: string): bool;

[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_interstitial_show([type_hint=`uint64`] handle: gmval, [type_hint=`string?`] placement_id: gmval): gmval;

/// Removes the handle and releases the native ad instance. No-op for an already-invalid handle. The
/// SDK exposes no dispose/destroy method on this class - this is wrapper-side cleanup only.
[global, bind = typed_gml]
function levelplay_interstitial_destroy([type_hint=`uint64`] handle: gmval): unit;

/// Returns every currently-live interstitial handle (created but not yet destroyed). Intended for
/// leak detection during development - e.g. logging array_length(...) periodically to catch handles
/// that are never destroyed.
[global, bind = typed_gml, type_hint = `uint64[]`]
function levelplay_interstitial_get_live_handles(): gmval;

// -----------------------------------------------------------------------------
// Rewarded video
// -----------------------------------------------------------------------------

/// Constructs the rewarded video ad instance and attaches callback as its listener for the handle's
/// whole lifetime (Loaded/LoadFailed, then every subsequent Displayed/DisplayFailed/Closed/Clicked/
/// InfoChanged/Rewarded event). Callback receives (result: [[LevelPlayResult]], type:
/// [[LevelPlayCallbackEvent]], ad_info: [[LevelPlayAdInfo]]?, reward: [[LevelPlayReward]]? - present
/// only when type == Rewarded). Synchronous and effectively infallible - the returned handle is
/// reusable across many load/show cycles; call levelplay_rewarded_video_destroy when truly done with it.
[global, bind = typed_gml, type_hint = `uint64`]
function levelplay_rewarded_video_create(ad_unit_id: string, callback: func): gmval;

/// Requests a (re)load using the handle's existing callback (see levelplay_rewarded_video_create /
/// levelplay_rewarded_video_set_callback).
[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_rewarded_video_load([type_hint=`uint64`] handle: gmval): gmval;

/// Replaces the handle's active callback, in place of the one given to levelplay_rewarded_video_create.
[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_rewarded_video_set_callback([type_hint=`uint64`] handle: gmval, callback: func): gmval;

[global, bind = typed_gml]
function levelplay_rewarded_video_is_ready([type_hint=`uint64`] handle: gmval): bool;

[global, bind = typed_gml]
function levelplay_rewarded_video_is_placement_capped(placement_id: string): bool;

[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_rewarded_video_show([type_hint=`uint64`] handle: gmval, [type_hint=`string?`] placement_id: gmval): gmval;

/// Removes the handle and releases the native ad instance. No-op for an already-invalid handle. The
/// SDK exposes no dispose/destroy method on this class - this is wrapper-side cleanup only.
[global, bind = typed_gml]
function levelplay_rewarded_video_destroy([type_hint=`uint64`] handle: gmval): unit;

/// Returns every currently-live rewarded video handle (created but not yet destroyed). Intended for
/// leak detection during development - e.g. logging array_length(...) periodically to catch handles
/// that are never destroyed.
[global, bind = typed_gml, type_hint = `uint64[]`]
function levelplay_rewarded_video_get_live_handles(): gmval;

// -----------------------------------------------------------------------------
// Banner
// -----------------------------------------------------------------------------

[global, bind = typed_gml, type_hint = `LevelPlayError`]
function levelplay_banner_create(ad_unit_id: string, [type_hint=`LevelPlayBannerSize`] size, [type_hint=`LevelPlayBannerHAlign`] align_h, [type_hint=`LevelPlayBannerVAlign`] align_v): gmval;

[global, bind = typed_gml]
function levelplay_banner_move([type_hint=`LevelPlayBannerHAlign`] align_h, [type_hint=`LevelPlayBannerVAlign`] align_v): unit;

[global, bind = typed_gml]
function levelplay_banner_destroy(): unit;

/// Callback receives (result: [[LevelPlayResult]], type: [[LevelPlayCallbackEvent]], ad_info: [[LevelPlayAdInfo]]?).
[global, bind = typed_gml]
function levelplay_banner_callback_subscribe(callback: func): unit;

[global, bind = typed_gml]
enum LevelPlayBannerSize:uint32
{
    Banner,
    Large,
    MediumRectangle,
    Adaptive,
}

[global, bind = typed_gml]
enum LevelPlayBannerHAlign:uint32
{
    Left,
    Center,
    Right,
}

[global, bind = typed_gml]
enum LevelPlayBannerVAlign:uint32
{
    Top,
    Center,
    Bottom,
}

[global, bind = typed_gml]
enum LevelPlayCallbackEvent:uint32
{
    Loaded,
    LoadFailed,
    Displayed,
    DisplayFailed,
    Closed,
    Clicked,
    InfoChanged,
    Rewarded,
    Expanded,
    Collapsed,
    LeftApplication,
}

[global, bind = typed_gml]
enum LevelPlayError:int32
{
    Ok,
    NotInitialized,
    AdNotReady,
    PlacementCapped,
    ActivityUnavailable,
    RootViewUnavailable,
    MissingAppKey,
    InvalidHandle,
}
